# Variante ohne Docker, z. B. in einem Debian-LXC mit Node 22 oder neuer.
# Ablegen unter /etc/systemd/system/spieleblock.service, dann:
#   systemctl daemon-reload && systemctl enable --now spieleblock
# In /opt/spieleblock liegen server.mjs und der Ordner public (= Inhalt von packages/server/dist).
[Unit]
Description=Spieleblock
After=network.target

[Service]
User=spieleblock
WorkingDirectory=/opt/spieleblock
Environment=PORT=3000
Environment=DATA_DIR=/var/lib/spieleblock
# Environment=ACCESS_KEY=dein-geheimer-zugangscode
# Nur für Hitster (docs/betrieb.md):
# Environment=SPOTIFY_CLIENT_ID=deine-spotify-client-id
# Erlaubt den versteckten Knopf „Jetzt nach Update suchen“; braucht spieleblock-update.path (docs/betrieb.md):
# Environment=UPDATE_FROM_UI=1
ExecStart=/usr/bin/node server.mjs
Restart=always
RestartSec=3
# Der Server schreibt beim Beenden einen Snapshot
TimeoutStopSec=15
StateDirectory=spieleblock
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/spieleblock

[Install]
WantedBy=multi-user.target
