# Prüft auf ein neues GitHub-Release und installiert es. Wird vom Timer (alle 2 Minuten) und von
# spieleblock-update.path (Knopf in der Oberfläche) gestartet.
# Ablegen unter /etc/systemd/system/, das Skript unter /usr/local/sbin/spieleblock-update (siehe docs/betrieb.md).
[Unit]
Description=Spieleblock auf neues Release prüfen
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# Ohne Docker (Standard):
Environment=MODE=systemd
# Dort liegen update-status.json und update-request (derselbe Ordner wie DATA_DIR des Servers):
Environment=DATA_DIR=/var/lib/spieleblock
# Mit Docker stattdessen:
# Environment=MODE=docker
# Environment=COMPOSE_DIR=/pfad/zu/spieleblock
ExecStart=/usr/local/sbin/spieleblock-update
